{
  "$schema": "https://mintlify.com/docs.json",
  "name": "ollamacmf",
  "colors": {
    "primary": "#000",
    "light": "#b5b5b5",
    "dark": "#000"
  },
  "theme": "maple",
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#000000"
    }
  },
  "fonts": {
    "family": "system-ui",
    "heading": {
      "family": "system-ui"
    },
    "body": {
      "family": "system-ui"
    }
  },
  "styling": {
    "codeblocks": "system"
  },
  "contextual": {
    "options": [
      "copy"
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/infosave2007/ollamacmf"
      },
      {
        "label": "Upstream Ollama",
        "href": "https://github.com/ollama/ollama"
      }
    ],
    "primary": {
      "type": "button",
      "label": "CMF quick start",
      "href": "/cmf"
    }
  },
  "api": {
    "playground": {
      "display": "simple"
    },
    "examples": {
      "languages": [
        "curl"
      ]
    }
  },
  "redirects": [
    {
      "source": "/development.md",
      "destination": "/development"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "CMF",
        "groups": [
          {
            "group": "ollamacmf",
            "expanded": true,
            "pages": [
              "index",
              "/cmf",
              "/cmf-engine",
              "/cmf-release-automation",
              "/development"
            ]
          }
        ]
      }
    ]
  }
}
